<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.currency.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="widget">tax_totals_company_currency_widget</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_totals']/.." position="after">
                <field
                    name="total_currencies"
                    widget="total_currencies_widget"
                    nolabel="1"
                />
                <field name="lines_with_rate_difference" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list" position="attributes">
                <attribute name="decoration-danger">warning_rate_difference</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='price_subtotal']" position="after">
                <field name="price_subtotal_currency" column_invisible="parent.currency_id == parent.company_currency_id"/>
                <field name="has_rate_difrerence" column_invisible="1"/>
                <field name="manually_price_subtotal_currency" column_invisible="1"/>
                <button 
                    name="reset_price_subtotal_currency" 
                    string="Reset" 
                    type="object" 
                    icon="fa-refresh" 
                    invisible="not has_rate_difrerence" 
                    column_invisible="not parent.lines_with_rate_difference"/>
                <field name="currency_rate" string="Tasa de Cambio" optional="hide" readonly="0" digits="[16,16]"/>
            </xpath>
            <xpath
                expr="//group[hasclass('oe_invoice_lines_tab', 'overflow-hidden')]/group[field[@name='narration']]"
                position="attributes"
            >
                <attribute name="colspan">6</attribute>
            </xpath>
            <xpath
                expr="//group[hasclass('oe_invoice_lines_tab', 'overflow-hidden')]/group[.//field[@name='tax_totals']]"
                position="attributes"
            >
                <attribute name="colspan">6</attribute>
            </xpath>
        </field>
    </record>


