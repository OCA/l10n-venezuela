<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.currency.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="invoice_currency_rate"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']/.." position="after">
                <field name="total_currencies" widget="total_currencies_widget" nolabel="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list[1]" position="inside">
                <field name="subtotal_company_currency" column_invisible="parent.company_currency_id == parent.currency_id"/>
            </xpath>
        </field>
    </record>
</odoo>
