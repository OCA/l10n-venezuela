<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View res.currency form -->
    <record id="view_res_currency_form" model="ir.ui.view">
        <field name="name">view.res.currency.form</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_fields" type="object" string="Crear columnas" class="oe_highlight" groups="base.group_no_one"/>
                    <button name="action_delete_fields" type="object" string="Eliminar columnas" confirm="Se eliminaran todas las columnas dinamicas asociadas a esta moneda. Deseas continuar?" groups="base.group_no_one"/>
                </header>
            </xpath>
        </field>
    </record>


