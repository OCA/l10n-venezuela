<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="currency_account.TotalCurrenciesWidget" owl="1">
        <div class="o_total_currencies_widget">
            <t t-log="totals"/>
            <t t-if="totals.length > 0">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th class="text-end ms-4 me-4">Total Factura</th>
                            <th class="text-end">Pendiente por Pagar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="totals" t-as="total" t-key="total_index">
                            <tr>
                                <td class="text-end">
                                    <t t-esc="formatAmount(total, 'total')"/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="formatAmount(total, 'residual')"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else="">
                <span class="text-muted">No hay totales por moneda.</span>
            </t>
        </div>
    </t>
</templates>
