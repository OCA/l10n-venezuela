<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="currency_account.TaxTotalsCompanyCurrencyWidget" owl="1">
        <t t-if="taxTotals">
            <table class="float-end">
                <tbody>
                    <t t-if="taxTotals.subtotals">
                        <t
                            t-foreach="taxTotals.subtotals"
                            t-as="subtotal"
                            t-key="subtotal_index"
                        >
                            <tr>
                                <td class="o_td_label">
                                    <label
                                        class="o_form_label o_tax_total_label"
                                        t-out="subtotal.name"
                                    />
                                </td>
                                <td class="o_list_monetary">
                                    <span
                                        t-att-name="subtotal.name"
                                        style="white-space: nowrap; font-weight: bold;"
                                        t-out="formatAmount(subtotal.base_amount_currency || 0, false)"
                                    />
                                </td>
                                <t t-if="taxTotals.display_in_company_currency">
                                    <td class="o_list_monetary ps-5">
                                        <span
                                            t-att-name="subtotal.name"
                                            style="white-space: nowrap; font-weight: bold;"
                                            t-out="formatAmount(subtotal.base_amount || 0, true)"
                                        />
                                    </td>
                                </t>
                            </tr>

                            <t
                                t-foreach="subtotal.tax_groups"
                                t-as="taxGroup"
                                t-key="taxGroup_index"
                            >
                                <tr>
                                    <td class="o_td_label">
                                        <label
                                            class="o_form_label o_tax_total_label"
                                            t-out="taxGroup.group_name"
                                        />
                                    </td>
                                    <td class="o_list_monetary">
                                        <span
                                            class="o_tax_group_amount_value o_list_monetary text-nowrap"
                                        >
                                            <t
                                                t-out="'(' + formatAmount(taxGroup.display_base_amount_currency ?? taxGroup.base_amount_currency ?? 0, false) + ') ' + formatAmount(taxGroup.tax_amount_currency || 0, false)"
                                                style="white-space: nowrap;"
                                            />
                                        </span>
                                    </td>
                                    <t t-if="taxTotals.display_in_company_currency">
                                        <td class="o_list_monetary ps-5">
                                            <span
                                                class="o_tax_group_amount_value o_list_monetary text-nowrap"
                                            >
                                                <t
                                                    t-out="'(' + formatAmount(taxGroup.display_base_amount ?? taxGroup.base_amount ?? 0, true) + ') ' + formatAmount(taxGroup.tax_amount || 0, true)"
                                                    style="white-space: nowrap;"
                                                />
                                            </span>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </t>
                    </t>

                    <t t-if="'cash_rounding_base_amount_currency' in taxTotals">
                        <tr>
                            <td class="o_td_label">
                                <label
                                    class="o_form_label o_tax_total_label"
                                >Rounding</label>
                            </td>
                            <td class="o_list_monetary">
                                <span
                                    t-out="formatAmount(taxTotals.cash_rounding_base_amount_currency, false)"
                                />
                            </td>
                            <t t-if="taxTotals.display_in_company_currency">
                                <td class="o_list_monetary ps-5">
                                    <span
                                        t-out="formatAmount(taxTotals.cash_rounding_base_amount || 0, true)"
                                    />
                                </td>
                            </t>
                        </tr>
                    </t>

                    <!-- Total amount with all taxes-->
                    <tr>
                        <td class="o_td_label">
                            <label class="o_form_label o_tax_total_label">Total</label>
                        </td>
                        <td class="o_list_monetary">
                            <span
                                name="amount_total"
                                t-att-class="{'oe_subtotal_footer_separator': taxTotals.has_tax_groups}"
                                t-out="formatAmount(taxTotals.total_amount_currency || 0, false)"
                                style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                            />
                        </td>
                        <t t-if="taxTotals.display_in_company_currency">
                            <td class="o_list_monetary ps-5">
                                <span
                                    name="amount_total_company"
                                    t-att-class="{'oe_subtotal_footer_separator': taxTotals.has_tax_groups}"
                                    t-out="formatAmount(taxTotals.total_amount || 0, true)"
                                    style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                                />
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </t>
    </t>
</templates>
