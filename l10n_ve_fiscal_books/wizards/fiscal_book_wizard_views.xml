<odoo>
    <record id="l10n_ve_fiscal_book_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.fiscal.book.wizard.form</field>
        <field name="model">l10n.ve.fiscal.book.wizard</field>
        <field name="arch" type="xml">
            <form string="Venezuelan Fiscal Books">
                <group>
                    <group>
                        <field name="book_type" widget="radio" />
                        <field name="company_id" invisible="1" />
                    </group>
                    <group>
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                </group>
                <group invisible="not file">
                    <field name="filename" invisible="1" />
                    <field name="file" filename="filename" readonly="1" />
                </group>
                <footer>
                    <button
                        name="action_generate"
                        string="Generate"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Close"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_ve_fiscal_book_sale_action" model="ir.actions.act_window">
        <field name="name">Sales Book</field>
        <field name="res_model">l10n.ve.fiscal.book.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_book_type': 'sale'}</field>
    </record>

    <record id="l10n_ve_fiscal_book_purchase_action" model="ir.actions.act_window">
        <field name="name">Purchase Book</field>
        <field name="res_model">l10n.ve.fiscal.book.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_book_type': 'purchase'}</field>
    </record>

    <menuitem
        id="l10n_ve_fiscal_books_menu"
        name="Venezuelan Fiscal Books"
        parent="account.menu_finance_reports"
        sequence="90"
        groups="account.group_account_invoice"
    />
    <menuitem
        id="l10n_ve_fiscal_book_sale_menu"
        name="Sales Book"
        parent="l10n_ve_fiscal_books_menu"
        action="l10n_ve_fiscal_book_sale_action"
        sequence="10"
    />
    <menuitem
        id="l10n_ve_fiscal_book_purchase_menu"
        name="Purchase Book"
        parent="l10n_ve_fiscal_books_menu"
        action="l10n_ve_fiscal_book_purchase_action"
        sequence="20"
    />
</odoo>
