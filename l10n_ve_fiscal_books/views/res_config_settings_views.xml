<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.l10n.ve.fiscal.books</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Venezuelan Localization" name="l10n_ve_fiscal_books">
                    <setting
                        string="Fiscal Machine"
                        help="Registration number included in the daily sales-book row."
                    >
                        <field name="pos_l10n_ve_machine_serial" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
