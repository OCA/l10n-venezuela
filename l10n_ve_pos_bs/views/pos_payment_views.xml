<odoo>
    <record id="view_pos_payment_form" model="ir.ui.view">
        <field name="name">pos.payment.form.l10n.ve.pos.bs</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form" />
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="l10n_ve_amount_ves" invisible="not l10n_ve_amount_ves" />
                <field name="l10n_ve_ves_rate" invisible="not l10n_ve_amount_ves" />
                <field name="l10n_ve_pos_amount" invisible="1" />
            </field>
        </field>
    </record>

    <record id="view_pos_payment_tree" model="ir.ui.view">
        <field name="name">pos.payment.list.l10n.ve.pos.bs</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree" />
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="l10n_ve_amount_ves" optional="show" />
                <field name="l10n_ve_ves_rate" optional="hide" />
                <field name="payment_ref_no" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_pos_payment_search" model="ir.ui.view">
        <field name="name">pos.payment.search.l10n.ve.pos.bs</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="payment_ref_no" />
            </field>
        </field>
    </record>
</odoo>
