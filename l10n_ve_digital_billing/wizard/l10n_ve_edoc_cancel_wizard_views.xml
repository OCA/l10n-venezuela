<odoo>
    <record id="view_l10n_ve_edoc_cancel_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ve.edoc.cancel.wizard.form</field>
        <field name="model">l10n.ve.edoc.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel at the digital printing house">
                <div class="alert alert-warning" role="alert">
                    This cancels the document at the digital printing house
                    (its control number becomes void for fiscal purposes). It
                    does NOT cancel the journal entry: the credit note or the
                    cancellation in Odoo is a separate step.
                </div>
                <group>
                    <field name="move_id"/>
                    <field name="reason"
                           placeholder="E.g.: error in the buyer's data"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Cancel at the printing house"
                            class="btn-danger" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
