<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_l10n_ve_pos" model="ir.ui.view">
        <field name="name">product.template.form.l10n.ve.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group[@name='pos']/field[@name='to_weight']" position="after">
                <field name="l10n_ve_pos_allow_price_change"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_view_form_normalized_pos" model="ir.ui.view">
        <field name="name">product.product.view.form.normalized.pos.l10n.ve</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="point_of_sale.product_product_view_form_normalized_pos"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="readonly">context.get('l10n_ve_pos_lock_price') and not l10n_ve_pos_allow_price_change</attribute>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="l10n_ve_pos_allow_price_change"/>
            </xpath>
        </field>
    </record>

    <record id="point_of_sale.product_product_action_edit_pos" model="ir.actions.act_window">
        <field name="context" eval="{'dialog_size': 'medium', 'l10n_ve_pos_lock_price': True}"/>
    </record>
</odoo>
