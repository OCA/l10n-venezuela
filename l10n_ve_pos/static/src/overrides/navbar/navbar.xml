<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_ve_pos.Navbar"
        t-inherit="point_of_sale.Navbar"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[.//i[contains(@class,'fa-barcode')]]" position="after">
            <PosExchangeRatesDropdown
                t-if="isVenezuelaPos and pos.mainScreen.component.name == 'ProductScreen'"
                t-key="'l10n_ve_pos_exchange_rates'"
            />
        </xpath>
    </t>
</templates>
