<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_ve_pos.ControlButtons"
        t-inherit="point_of_sale.ControlButtons"
        t-inherit-mode="extension"
    >
        <xpath expr="//SelectPartnerButton" position="after">
            <button
                t-if="!props.showRemainingButtons and availableInvoiceJournals.length"
                t-att-class="buttonClass"
                t-att-disabled="!canChangeInvoiceJournal"
                t-on-click="() => this.clickInvoiceJournal()"
            >
                <i
                    class="fa fa-book me-1"
                    role="img"
                    aria-label="Invoice journal"
                    title="Invoice journal"
                />
                <t
                    t-if="currentOrder?.invoice_journal_id"
                    t-esc="currentOrder.invoice_journal_id.display_name || currentOrder.invoice_journal_id.name"
                />
                <t t-else="">Diario</t>
            </button>
        </xpath>
        <xpath
            expr="//t[@t-if='props.showRemainingButtons']//div[hasclass('control-buttons')]"
            position="inside"
        >
            <button
                t-if="availableInvoiceJournals.length"
                t-att-class="buttonClass"
                t-att-disabled="!canChangeInvoiceJournal"
                t-on-click="() => this.clickInvoiceJournal()"
            >
                <i
                    class="fa fa-book me-1"
                    role="img"
                    aria-label="Invoice journal"
                    title="Invoice journal"
                />
                <t
                    t-if="currentOrder?.invoice_journal_id"
                    t-esc="currentOrder.invoice_journal_id.display_name || currentOrder.invoice_journal_id.name"
                />
                <t t-else="">Diario</t>
            </button>
        </xpath>
    </t>
</templates>
