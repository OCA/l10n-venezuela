<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_ve_pos.TicketScreen"
        t-inherit="point_of_sale.TicketScreen"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[contains(@class, 'header-row')]/div[2]" position="replace">
            <div class="col wide p-2">
                <t t-esc="ticketScreenPosReferenceHeader" />
            </div>
        </xpath>
        <xpath
            expr="//div[@class='control-buttons d-flex gap-2 pb-2']/button[last()]"
            position="replace"
        >
            <button
                t-if="!isVenezuelaPos"
                class="control-button btn btn-light btn-lg lh-lg flex-grow-1 flex-shrink-1"
                t-on-click="() => doPrint.call(_selectedSyncedOrder)"
            >
                <i
                    t-attf-class="fa {{doPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1"
                />
                <t t-esc="ticketScreenSyncedPrintLabel" />
            </button>
        </xpath>
    </t>
</templates>
