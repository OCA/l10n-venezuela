<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_l10n_ve_edi_tfhka" model="ir.ui.view">
        <field name="name">account.journal.form.l10n.ve.edi.tfhka</field>
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="l10n_ve_edi.view_account_journal_form_l10n_ve_edi"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='l10n_ve_edi_digital_group']" position="inside">
                <field
                    name="l10n_ve_edi_tfhka_serie"
                    invisible="l10n_ve_edi_provider != 'tfhka'"
                />
                <field
                    name="l10n_ve_edi_tfhka_sucursal"
                    invisible="l10n_ve_edi_provider != 'tfhka'"
                />
                <field
                    name="l10n_ve_edi_tfhka_environment_digit"
                    invisible="l10n_ve_edi_provider != 'tfhka'"
                />
            </xpath>
        </field>
    </record>
</odoo>
