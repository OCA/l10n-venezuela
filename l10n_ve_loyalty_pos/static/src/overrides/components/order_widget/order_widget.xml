<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_ve_loyalty_pos.OrderWidget"
        t-inherit="point_of_sale.OrderWidget"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//div[hasclass('order-summary')]/div[hasclass('d-flex') and hasclass('justify-content-between') and hasclass('w-100') and hasclass('fs-2')]"
            position="before"
        >
            <t t-if="taxTotals and taxTotals.l10n_ve_show_global_discount">
                <div class="d-flex justify-content-between w-100 fs-6 text-muted">
                    <span>Subtotal</span>
                    <span
                        t-esc="formatMonetary(taxTotals.order_sign * taxTotals.l10n_ve_subtotal_before_discount, {currencyId: taxTotals.currency_id})"
                    />
                </div>
                <t
                    t-foreach="taxTotals.l10n_ve_global_discount_lines"
                    t-as="discountLine"
                    t-key="discountLine.id"
                >
                    <div class="d-flex justify-content-between w-100 fs-6 text-danger">
                        <span t-esc="discountLine.name"/>
                        <span
                            t-esc="formatMonetary(-taxTotals.order_sign * discountLine.amount, {currencyId: taxTotals.currency_id})"
                        />
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>
