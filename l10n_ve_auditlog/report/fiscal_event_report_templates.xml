<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_fiscal_document_event">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Eventos de documentos fiscales</h2>
                        <p>
                            <strong>Documento:</strong>
                            <span t-esc="doc.name" />
                        </p>
                        <p>
                            <strong>Fecha:</strong>
                            <span t-field="doc.create_date" t-options='{"widget": "datetime"}' />
                        </p>
                        <p>
                            <strong>Usuario:</strong>
                            <span t-esc="doc.user_id.name" />
                        </p>
                        <p>
                            <strong>Tipo de evento:</strong>
                            <span t-esc="dict(doc._fields['fiscal_event_type'].selection).get(doc.fiscal_event_type, '')" />
                        </p>
                        <p>
                            <strong>Descripción:</strong>
                        </p>
                        <p t-esc="doc.fiscal_event_description" />
                    </div>
                </t>
            </t>
        </t>
    </template>
    <template id="report_fiscal_document_event_list">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Eventos de documentos fiscales</h2>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Documento</th>
                                <th>Evento</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td>
                                    <span t-field="doc.create_date" t-options='{"widget": "datetime"}' />
                                </td>
                                <td><span t-esc="doc.user_id.name" /></td>
                                <td><span t-esc="doc.name" /></td>
                                <td>
                                    <span t-esc="dict(doc._fields['fiscal_event_type'].selection).get(doc.fiscal_event_type, '')" />
                                </td>
                                <td><span t-esc="doc.fiscal_event_description" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
