<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_fiscal_document_event_list" model="ir.actions.report">
        <field name="name">Fiscal Document Events List</field>
        <field name="model">auditlog.log</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >l10n_ve_auditlog.report_fiscal_document_event_list</field>
        <field
            name="report_file"
        >l10n_ve_auditlog.report_fiscal_document_event_list</field>
        <field name="binding_model_id" ref="model_auditlog_log" />
        <field name="binding_type">report</field>
        <field
            name="print_report_name"
        >'Eventos fiscales - %s' % (time.strftime('%Y-%m-%d'))</field>
    </record>
</odoo>
