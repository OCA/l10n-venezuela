<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditlog_account_report_access_tree" model="ir.ui.view">
        <field name="name">auditlog.account.report.access.list</field>
        <field name="model">auditlog.account.report.access</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="access_date" />
                <field name="user_id" />
                <field name="source" />
                <field name="ir_action_type" optional="show" />
                <field name="ir_action_id" optional="hide" />
                <field name="report_name" />
                <field name="report_model" optional="show" />
                <field name="account_report_id" optional="hide" />
                <field name="file_generator" optional="hide" />
                <field name="ip_address" optional="hide" />
                <field name="http_path" optional="hide" />
            </list>
        </field>
    </record>
    <record id="view_auditlog_account_report_access_form" model="ir.ui.view">
        <field name="name">auditlog.account.report.access.form</field>
        <field name="model">auditlog.account.report.access</field>
        <field name="arch" type="xml">
            <form string="Accounting Report Access" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="access_date" />
                        <field name="user_id" />
                        <field name="source" />
                        <field name="ir_action_type" />
                        <field name="ir_action_id" />
                        <field name="report_name" />
                        <field name="report_model" />
                        <field name="account_report_id" />
                        <field name="file_generator" />
                        <field name="ip_address" />
                        <field name="http_path" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_auditlog_account_report_access_search" model="ir.ui.view">
        <field name="name">auditlog.account.report.access.search</field>
        <field name="model">auditlog.account.report.access</field>
        <field name="arch" type="xml">
            <search string="Accounting Report Access">
                <field name="report_name" />
                <field name="report_model" />
                <field name="user_id" />
                <field name="source" />
                <separator />
                <filter name="filter_today" string="Today" domain="[('access_date', '>=', (context_today()).strftime('%Y-%m-%d'))]" />
                <group string="Group By" expand="0">
                    <filter name="group_source" string="Source" domain="[]" context="{'group_by':'source'}" />
                    <filter name="group_user" string="User" domain="[]" context="{'group_by':'user_id'}" />
                    <filter name="group_report_model" string="Report Model" domain="[]" context="{'group_by':'report_model'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_auditlog_account_report_access" model="ir.actions.act_window">
        <field name="name">Accounting Report Consultations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">auditlog.account.report.access</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auditlog_account_report_access_search" />
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>
    <menuitem id="menu_action_auditlog_account_report_access" parent="menu_audit" action="action_auditlog_account_report_access" sequence="37" />
</odoo>
