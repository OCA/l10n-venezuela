<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditlog_validation_exception_tree" model="ir.ui.view">
        <field name="name">auditlog.validation.exception.list</field>
        <field name="model">auditlog.validation.exception</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" />
                <field name="exception_class" />
                <field name="user_id" />
                <field name="http_path" optional="show" />
                <field name="ip_address" optional="hide" />
                <field name="rpc_model" optional="hide" />
                <field name="rpc_method" optional="hide" />
                <field name="message" optional="show" />
            </list>
        </field>
    </record>
    <record id="view_auditlog_validation_exception_form" model="ir.ui.view">
        <field name="name">auditlog.validation.exception.form</field>
        <field name="model">auditlog.validation.exception</field>
        <field name="arch" type="xml">
            <form string="Validation Exception" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="create_date" />
                        <field name="exception_class" />
                        <field name="user_id" />
                        <field name="http_path" />
                        <field name="ip_address" />
                        <field name="rpc_model" />
                        <field name="rpc_method" />
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_auditlog_validation_exception_search" model="ir.ui.view">
        <field name="name">auditlog.validation.exception.search</field>
        <field name="model">auditlog.validation.exception</field>
        <field name="arch" type="xml">
            <search string="Validation Exceptions">
                <field name="message" />
                <field name="exception_class" />
                <field name="user_id" />
                <field name="ip_address" />
                <separator />
                <filter name="filter_today" string="Today" domain="[('create_date', '>=', (context_today()).strftime('%Y-%m-%d'))]" />
                <group string="Group By" expand="0">
                    <filter name="group_exception_class" string="Type" domain="[]" context="{'group_by':'exception_class'}" />
                    <filter name="group_user" string="User" domain="[]" context="{'group_by':'user_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_auditlog_validation_exception" model="ir.actions.act_window">
        <field name="name">Validation Exceptions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">auditlog.validation.exception</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auditlog_validation_exception_search" />
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>
    <menuitem id="menu_action_auditlog_validation_exception" parent="menu_audit" action="action_auditlog_validation_exception" sequence="36" />
</odoo>
