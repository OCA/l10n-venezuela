<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.l10n.ve.igtf</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='amount_div']" position="after">
                <field name="l10n_ve_igtf_available" invisible="1" />
                <field
                    name="l10n_ve_igtf_apply"
                    invisible="not l10n_ve_igtf_available"
                    readonly="state != 'draft'"
                />
                <field
                    name="l10n_ve_igtf_rate"
                    invisible="not l10n_ve_igtf_apply"
                    readonly="state != 'draft'"
                />
                <field name="l10n_ve_igtf_amount" invisible="not l10n_ve_igtf_apply" />
            </xpath>
        </field>
    </record>
</odoo>
