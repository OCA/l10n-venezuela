<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_ve_igtf" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n_ve_igtf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_seniat.res_config_settings_l10n_ve_seniat" />
        <field name="priority" eval="25" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@id='l10n_ve_seniat_div_lock_fiscal_data']"
                position="after"
            >
                <field name="l10n_ve_igtf_settings_eligible" invisible="1" />
                <setting
                    name="l10n_ve_igtf_settings"
                    string="IGTF"
                    help="Configuración de IGTF para compañías con país fiscal Venezuela y tipo de contribuyente Especial."
                    invisible="not l10n_ve_igtf_settings_eligible"
                >
                    <div class="content-group">
                        <div class="row mt16">
                            <label
                                string="Cuenta IGTF"
                                for="l10n_ve_igtf_account_id"
                                class="col-lg-6 o_light_label"
                            />
                            <field
                                name="l10n_ve_igtf_account_id"
                                class="col-lg-6"
                                required="l10n_ve_igtf_settings_eligible"
                                domain="[('account_type', 'in', ('liability_current', 'liability_non_current'))]"
                                options="{'no_create': True}"
                            />
                        </div>
                        <div class="row mt16">
                            <label
                                string="Monedas IGTF"
                                for="l10n_ve_igtf_currency_ids"
                                class="col-lg-6 o_light_label"
                            />
                            <field
                                name="l10n_ve_igtf_currency_ids"
                                widget="many2many_tags"
                                class="col-lg-6"
                            />
                        </div>
                        <div class="row mt16">
                            <label
                                string="IGTF en facturas"
                                for="l10n_ve_igtf_allow_invoice_accrual"
                                class="col-lg-6 o_light_label"
                            />
                            <field
                                name="l10n_ve_igtf_allow_invoice_accrual"
                                class="col-lg-6"
                            />
                        </div>
                        <div class="row mt16">
                            <div class="col-lg-6" />
                            <div class="col-lg-6 text-muted">
                                Si está desactivado, el IGTF solo se aplica al registrar
                                cobros o pagos; no se generan líneas de IGTF al confirmar
                                la factura en divisa.
                            </div>
                        </div>
                        <div class="row mt16">
                            <label
                                string="IGTF (%)"
                                for="l10n_ve_igtf_percent"
                                class="col-lg-6 o_light_label"
                            />
                            <field
                                name="l10n_ve_igtf_percent"
                                class="col-lg-6"
                                string="IGTF (%)"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
