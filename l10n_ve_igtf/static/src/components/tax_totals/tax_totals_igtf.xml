<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-inherit="account.TaxTotalsField" t-inherit-mode="extension">
        <!-- Necessary: replace the total row so IGTF can show Total
             and Total con IGTF. Hiding the original would leave a
             duplicate amount_total span. -->
        <xpath expr="//tr[.//span[@name='amount_total']]" position="replace">
            <t t-if="'l10n_ve_igtf_total_without_igtf_currency' in totals">
                <tr>
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label">Total</label>
                    </td>
                    <td class="o_list_monetary">
                        <span
                            name="l10n_ve_igtf_total_without_igtf"
                            t-out="formatMonetary(totals.l10n_ve_igtf_total_without_igtf_currency)"
                            style="font-weight: 600; white-space: nowrap;"
                        />
                    </td>
                    <td
                        t-if="totals.display_in_company_currency"
                        class="o_list_monetary ps-5"
                    >
                        <span
                            name="l10n_ve_igtf_total_without_igtf_company"
                            t-out="formatMonetaryCompany(totals.l10n_ve_igtf_total_without_igtf)"
                            style="font-weight: 600; white-space: nowrap;"
                        />
                    </td>
                </tr>
                <tr>
                    <td class="o_td_label">
                        <label
                            class="o_form_label o_tax_total_label"
                        >Total con IGTF</label>
                    </td>
                    <td class="o_list_monetary">
                        <span
                            name="amount_total"
                            t-att-class="{'oe_subtotal_footer_separator': totals.has_tax_groups}"
                            t-out="formatMonetary(totals.total_amount_currency)"
                            style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                        />
                    </td>
                    <td
                        t-if="totals.display_in_company_currency"
                        class="o_list_monetary ps-5"
                    >
                        <span
                            name="amount_total_company"
                            t-att-class="{'oe_subtotal_footer_separator': totals.has_tax_groups}"
                            t-out="formatMonetaryCompany(totals.total_amount)"
                            style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                        />
                    </td>
                </tr>
            </t>
            <t t-else="">
                <tr>
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label">Total</label>
                    </td>
                    <td class="o_list_monetary">
                        <span
                            name="amount_total"
                            t-att-class="{'oe_subtotal_footer_separator': totals.has_tax_groups}"
                            t-out="formatMonetary(totals.total_amount_currency)"
                            style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                        />
                    </td>
                    <td
                        t-if="totals.display_in_company_currency"
                        class="o_list_monetary ps-5"
                    >
                        <span
                            name="amount_total_company"
                            t-att-class="{'oe_subtotal_footer_separator': totals.has_tax_groups}"
                            t-out="formatMonetaryCompany(totals.total_amount)"
                            style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                        />
                    </td>
                </tr>
            </t>
        </xpath>
    </t>
</templates>
