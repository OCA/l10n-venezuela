<odoo>
    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.form.l10n.ve.wh.iva</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <field name="property_account_position_id" position="after">
                <field name="l10n_ve_taxpayer_type" />
            </field>
            <xpath expr="//page[@name='accounting']" position="inside">
                <group name="l10n_ve_wh_iva" string="Retención de IVA (Venezuela)">
                    <field name="l10n_ve_wh_iva_rate" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
