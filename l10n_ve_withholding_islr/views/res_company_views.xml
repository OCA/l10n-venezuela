<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_wh_islr_inherit" model="ir.ui.view">
        <field name="name">res.company.form.wh.islr.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="wh_islr_page" string="ISLR Withholdings">
                    <group>
                        <group string="ISLR Withholding Configuration">
                            <field name="wh_islr_journal_id"/>
                            <field name="wh_islr_account_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
