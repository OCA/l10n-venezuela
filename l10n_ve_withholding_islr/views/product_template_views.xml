<odoo>
    <record id="product_template_form_view_islr" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.l10n.ve.wh.islr</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='invoicing']/group[@name='properties']"
                position="inside"
            >
                <group string="Retención ISLR (Venezuela)" name="l10n_ve_islr">
                    <field
                        name="l10n_ve_islr_concept_id"
                        options="{'no_create': True}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
