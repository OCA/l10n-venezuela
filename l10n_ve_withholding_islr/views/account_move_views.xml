<odoo>
    <record id="view_move_form_islr" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.l10n.ve.wh.islr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button
                    name="action_l10n_ve_create_islr_wh"
                    string="Crear retención de ISLR"
                    type="object"
                    groups="account.group_account_invoice"
                    invisible="not l10n_ve_islr_wh_pending"
                />
            </button>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']"
                position="after"
            >
                <field
                    name="l10n_ve_islr_concept_id"
                    optional="show"
                    options="{'no_create': True}"
                    column_invisible="parent.country_code != 'VE' or parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                />
            </xpath>
            <group id="other_tab_group" position="inside">
                <field name="l10n_ve_islr_wh_pending" invisible="1" />
                <group
                    string="Retención de ISLR"
                    name="l10n_ve_withholding_islr"
                    invisible="not l10n_ve_islr_voucher_ids"
                >
                    <field name="l10n_ve_islr_voucher_ids" nolabel="1" colspan="2">
                        <list>
                            <field name="number" />
                            <field name="concept_id" />
                            <field name="amount" />
                            <field name="currency_id" column_invisible="1" />
                            <field name="state" />
                        </list>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
