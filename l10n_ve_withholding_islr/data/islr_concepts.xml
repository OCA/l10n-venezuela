<odoo noupdate="1">
    <!-- Códigos oficiales del Anexo 6.1 del Manual Técnico XML del SENIAT
         (Decreto 1.808), columnas PN Residente / PJ Domiciliada / PN No
         Residente / PJ No Domiciliada, con el porcentaje de base imponible
         (enriquecimiento presunto) de cada columna; 100 cuando no es presunta.
         El código 000 (Declaración Sin Operaciones) NO se seedea como concepto:
         lo emite el wizard de export cuando el período no tiene comprobantes.
         Las columnas sin código en la tabla quedan en el default '000' (el
         export bloquea comprobantes con ese código). PN no residente: tarifa
         fija sin sustraendo. PJ no domiciliada: Tarifa N° 2 o tarifa fija,
         según la tabla. -->
    <record id="islr_concept_honorarios" model="l10n.ve.islr.concept">
        <field name="name">Honorarios Profesionales</field>
        <field name="seniat_code_pj">004</field>
        <field name="seniat_code_pn">002</field>
        <field name="rate_pj_dom">5.0</field>
        <field name="rate_pn_res">3.0</field>
        <field name="seniat_code_pn_nores">003</field>
        <field name="rate_pn_nores">34.0</field>
        <field name="base_pct_pn_nores">90.0</field>
        <field name="seniat_code_pj_nodom">005</field>
        <field name="pj_nodom_rate_type">tarifa2</field>
        <field name="base_pct_pj_nodom">90.0</field>
        <field name="apply_subtrahend" eval="True" />
    </record>
