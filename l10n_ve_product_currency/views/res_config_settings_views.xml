<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.form.inherit.l10n_ve_product_currency</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="product.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='manage_volume_uom_setting']" position="after">
                <setting
                    id="l10n_ve_product_currency_default_force_currency_setting"
                    string="Default product currency"
                    help="This currency is applied automatically when creating products. Leave it empty to use the company currency."
                    groups="base.group_multi_currency"
                >
                    <field
                        name="l10n_ve_product_currency_default_force_currency_id"
                        options="{'no_create': True}"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
