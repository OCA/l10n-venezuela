<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_payment_tree_l10n_ve_pos_igtf" model="ir.ui.view">
        <field name="name">pos.payment.tree.l10n.ve.pos.igtf</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_order_id']" position="after">
                <field name="include_igtf" optional="hide" />
                <field name="igtf_amount" optional="hide" />
                <field name="foreign_igtf_amount" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_form_l10n_ve_pos_igtf" model="ir.ui.view">
        <field name="name">pos.payment.form.l10n.ve.pos.igtf</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_order_id']" position="after">
                <field name="include_igtf" />
                <field name="igtf_amount" />
                <field name="foreign_igtf_amount" />
            </xpath>
        </field>
    </record>
</odoo>
