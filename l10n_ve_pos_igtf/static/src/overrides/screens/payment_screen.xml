<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_ve_pos_igtf.PaymentScreenDue"
        t-inherit="point_of_sale.PaymentScreenDue"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('total')]" position="after">
            <div
                t-if="l10nVePosShowIgtf"
                class="order-summary d-flex flex-column gap-2 px-3 pb-3 mx-auto w-100"
                style="max-width: 24rem;"
            >
                <div
                    class="d-flex justify-content-between align-items-baseline w-100 fs-4 text-muted fw-bolder lh-sm"
                >
                    <span t-esc="l10nVePosTotalLabel" />
                    <span t-esc="l10nVePosTotalWithoutIgtfText" />
                </div>
                <div
                    class="d-flex justify-content-between align-items-baseline w-100 fs-4 fw-bolder lh-sm"
                >
                    <span t-esc="l10nVePosIgtfLabel" />
                    <span t-esc="l10nVePosIgtfAmountText" />
                </div>
            </div>
        </xpath>
    </t>
</templates>
