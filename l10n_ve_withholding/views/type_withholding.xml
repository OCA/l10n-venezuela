<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_type_withholding_list_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">IVA Retention</field>
        <field name="model">account.withholding.type</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence, id">
                <field name="sequence" widget="handle" />
                <field name="name" required="1" />
                <field name="value" required="1" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_type_withholding_search_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">IVA retention percentage</field>
        <field name="model">account.withholding.type</field>
        <field name="arch" type="xml">
            <search string="IVA Retention">
                <field name="name" />
                <filter name="state" string="Active" domain="[('state','=',True)]" />
            </search>
        </field>
    </record>

    <record id="action_type_withholding" model="ir.actions.act_window">
        <field name="name">IVA retention percentage</field>
        <field name="res_model">account.withholding.type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_type_withholding_list_l10n_ve_withholding" />
        <field name="context">{"search_default_state":True}</field>
    </record>
</odoo>
