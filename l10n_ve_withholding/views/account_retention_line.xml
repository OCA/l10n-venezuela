<odoo>
    <record
        id="view_account_retention_line_tree_l10n_ve_withholding"
        model="ir.ui.view"
    >
        <field
            name="name"
        >views.account.retention.line.list.l10n.ve.payment.extension</field>
        <field name="model">account.retention.line</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Retention Lines">
                <field name="name" />
                <field name="affected_invoice_display_name" />
                <button
                    name="action_open_invoice"
                    type="object"
                    icon="fa-external-link"
                    title="Open affected invoice"
                    invisible="not move_id"
                />
                <field name="move_id" column_invisible="True" />
                <field name="payment_id" />
            </list>
        </field>
    </record>
    <record
        id="view_account_retention_line_form_l10n_ve_withholding"
        model="ir.ui.view"
    >
        <field
            name="name"
        >views.account.retention.line.form.l10n.ve.payment.extension</field>
        <field name="model">account.retention.line</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Retention Lines">
                <group>
                    <field name="name" />
                    <field name="affected_invoice_display_name" />
                    <button
                        name="action_open_invoice"
                        type="object"
                        string="Open affected invoice"
                        icon="fa-external-link"
                        invisible="not move_id"
                    />
                    <field name="move_id" invisible="1" />
                    <field name="base_ret" />
                    <field name="amount_tax_incurred" />
                    <field name="amount_tax_ret" />
                    <field name="invoice_amount" />
                    <field name="iva_amount" />
                    <field name="retention_amount" />
                    <field name="is_client_retention" invisible="1" />
                </group>
            </form>
        </field>
    </record>
</odoo>
