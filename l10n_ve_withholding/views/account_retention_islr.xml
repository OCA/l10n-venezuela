<odoo>
    <record id="view_retention_islr_form_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">Retention ISLR client form</field>
        <field name="model">account.retention</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Retention">
                <header>
                    <button
                        name="action_draft"
                        type="object"
                        string="Convert to draft"
                        invisible="type != 'out_invoice' or state != 'cancel'"
                    />
                    <button
                        name="action_post"
                        type="object"
                        invisible="state != 'draft'"
                        string="Approve"
                        class="oe_highlight"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        invisible="state != 'emitted'"
                        string="Cancel"
                        confirm="Are you sure you want to cancel this voucher? The associated accounting entries will be reversed"
                    />
                    <button
                        name="action_print_retention_voucher"
                        type="object"
                        string="Print"
                        icon="fa-print"
                        invisible="state != 'emitted'"
                    />
                    <field name="state" widget="statusbar" nolabel="1" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_currency_id" invisible="1" />
                            <field name="allowed_lines_move_ids" invisible="1" />
                            <field
                                name="type_retention"
                                force_save="1"
                                select="2"
                                invisible="1"
                            />
                            <field name="type" force_save="1" select="2" />
                            <field
                                name="partner_id"
                                on_change="onchange_partner_id(type,partner_id)"
                                select="1"
                                invisible="not type"
                                readonly="state in ['emitted', 'cancel']"
                            />
                            <field
                                name="number"
                                force_save="1"
                                readonly="type == 'in_invoice' or state in ['emitted', 'cancel']"
                                required="type == 'out_invoice'"
                            />
                            <field
                                name="correlative"
                                force_save="1"
                                invisible="1"
                                readonly="type == 'in_invoice'"
                            />
                        </group>
                        <group>
                            <field
                                name="date_accounting"
                                select="1"
                                readonly="state in ['emitted', 'cancel']"
                                required="1"
                            />
                            <field
                                name="date"
                                readonly="state in ['emitted', 'cancel']"
                            />
                        </group>
                    </group>
                    <group>
                        <field
                            name="affected_invoice_display_names"
                            readonly="1"
                            invisible="not affected_invoice_display_names"
                        />
                    </group>
                    <notebook colspan="4">
                        <page name="retention_lines" string="Retention Lines">
                            <field
                                colspan="4"
                                name="retention_line_ids"
                                nolabel="1"
                                invisible="not partner_id"
                                readonly="state in ['emitted', 'cancel']"
                            >
                                <list editable="bottom">
                                    <field name="name" readonly="1" force_save="1" />
                                    <field
                                        name="move_id"
                                        domain="['&amp;',('id', 'in', parent.allowed_lines_move_ids), ('islr_voucher_number', '=',False)]"
                                    />
                                    <field
                                        name="affected_invoice_display_name"
                                        readonly="1"
                                    />
                                    <button
                                        name="action_open_invoice"
                                        type="object"
                                        icon="fa-external-link"
                                        title="Open affected invoice"
                                        invisible="not move_id"
                                    />
                                    <field name="code" />
                                    <field
                                        name="company_id"
                                        optional="hide"
                                        groups="base.group_multi_company"
                                    />
                                    <field name="payment_concept_id" force_save="1" />
                                    <field
                                        name="is_client_retention"
                                        column_invisible="True"
                                    />
                                    <field
                                        name="invoice_total"
                                        force_save="1"
                                        string="Invoice Total"
                                        widget="monetary"
                                        options="{'currency_field': 'company_currency_id'}"
                                        readonly="1"
                                    />
                                    <field
                                        name="invoice_amount"
                                        force_save="1"
                                        string="Invoice Amount"
                                        widget="monetary"
                                        options="{'currency_field': 'company_currency_id'}"
                                    />

                                    <field
                                        name="related_pay_from"
                                        force_save="1"
                                        readonly="1"
                                        column_invisible="parent.type == 'out_invoice'"
                                    />
                                    <field
                                        name="related_percentage_tax_base"
                                        force_save="1"
                                        readonly="1"
                                    />
                                    <field
                                        name="related_percentage_fees"
                                        force_save="1"
                                        readonly="1"
                                    />
                                    <field
                                        name="related_amount_subtract_fees"
                                        force_save="1"
                                        readonly="1"
                                    />
                                    <field
                                        name="retention_amount"
                                        force_save="1"
                                        widget="monetary"
                                        options="{'currency_field': 'company_currency_id'}"
                                        readonly="parent.type == 'in_invoice'"
                                    />
                                </list>
                            </field>

                            <group col="2" colspan="2">
                                <field
                                    name="total_invoice_amount"
                                    widget="monetary"
                                    options="{'currency_field': 'company_currency_id'}"
                                />
                                <field
                                    name="total_retention_amount"
                                    widget="monetary"
                                    options="{'currency_field': 'company_currency_id'}"
                                />
                            </group>
                        </page>
                        <page name="Payments" string="payments">
                            <field
                                name="payment_ids"
                                nolabel="1"
                                invisible="not partner_id"
                                readonly="state in ['emitted', 'cancel']"
                            >
                                <list string="Payments" editable="bottom">
                                    <field name="date" />
                                    <field name="name" />
                                    <field name="currency_id" column_invisible="True" />
                                    <field
                                        name="amount"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_attachment="True" />
            </form>
        </field>
    </record>

    <record id="action_retention_islr_client" model="ir.actions.act_window">
        <field name="name">ISLR Retention client</field>
        <field name="res_model">account.retention</field>
        <field name="binding_view_types">list</field>
        <field name="view_mode">list,form</field>
        <!--field name="search_view_id" ref="view_search_retention_iva"/-->
        <field
            name="context"
        >{"default_type":'out_invoice', "default_type_retention":'islr'}</field>
        <field
            name="domain"
        >[('type_retention', '=', 'islr'), ('type', '=', 'out_invoice')]</field>
    </record>

    <!--Configuracion
        de Vista: Retenciones ISLR Proveedor-->
    <record id="action_retention_islr_supplier" model="ir.actions.act_window">
        <field name="name">ISLR Retention supplier</field>
        <field name="res_model">account.retention</field>
        <field name="binding_view_types">list</field>
        <field name="view_mode">list,form</field>
        <!--field name="search_view_id" ref="view_search_retention_iva"/-->
        <field
            name="context"
        >{"default_type":'in_invoice', "default_type_retention":'islr'}</field>
        <field
            name="domain"
        >[('type_retention', '=', 'islr'), ('type', '=', 'in_invoice')]</field>
    </record>
</odoo>
