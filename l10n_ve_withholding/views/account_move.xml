<odoo>
    <record id="account_move_form_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.payment.extension</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="iva_retention_id" invisible="1" />
                <field name="islr_retention_id" invisible="1" />
                <field
                    name="generate_iva_retention"
                    invisible="state != 'draft' or move_type not in ('in_invoice', 'in_receipt', 'in_refund')"
                />
                <label
                    for="iva_voucher_number"
                    string="Comprobante retención IVA"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not iva_voucher_number"
                />
                <div
                    class="d-inline-flex flex-nowrap align-items-center gap-2"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not iva_voucher_number"
                >
                    <field
                        name="iva_voucher_number"
                        nolabel="1"
                        readonly="1"
                        class="oe_inline w-auto"
                    />
                    <button
                        name="action_open_iva_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-external-link"
                        title="Abrir retención de IVA"
                        invisible="not iva_retention_id"
                    />
                    <button
                        name="action_print_iva_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-print"
                        title="Print IVA retention"
                        invisible="not iva_retention_id"
                    />
                </div>
                <label
                    for="islr_voucher_number"
                    string="Comprobante retención ISLR"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not islr_voucher_number"
                />
                <div
                    class="d-inline-flex flex-nowrap align-items-center gap-2"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not islr_voucher_number"
                >
                    <field
                        name="islr_voucher_number"
                        nolabel="1"
                        readonly="1"
                        class="oe_inline w-auto"
                    />
                    <button
                        name="action_open_islr_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-external-link"
                        title="Abrir retención de ISLR"
                        invisible="not islr_retention_id"
                    />
                    <button
                        name="action_print_islr_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-print"
                        title="Print ISLR retention"
                        invisible="not islr_retention_id"
                    />
                </div>
                <field
                    name="municipal_voucher_number"
                    readonly="1"
                    invisible="not municipal_voucher_number"
                />
                <field name="company_currency_id" invisible="1" />
            </xpath>

            <xpath expr="//field[@name='tax_lock_date_message']/parent::div" position="after">
                <field name="l10n_ve_missing_iva_withholding_type" invisible="1" />
                <div
                    class="alert alert-warning d-flex align-items-center mb-0"
                    role="alert"
                    invisible="not l10n_ve_missing_iva_withholding_type"
                >
                    El contacto seleccionado no tiene configurado el porcentaje de
                    retención de IVA. Configure el campo «Tipo de retención» en la
                    ficha del contacto antes de confirmar la operación.
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page
                    name="iva_retention"
                    string="IVA Retentions"
                    invisible="not retention_iva_line_ids"
                >
                    <field name="retention_iva_line_ids" nolabel="1" readonly="1">
                        <list editable='bottom'>
                            <!-- Invisible Fields -->
                            <field name="invoice_type" column_invisible="True" />
                            <field name="company_currency_id" column_invisible="True" />
                            <field name="name" />
                            <field name="move_id" />
                            <field name="aliquot" />
                            <field name="related_percentage_tax_base" optional="hide" />
                            <!-- Amounts -->
                            <field
                                name="invoice_total"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field
                                name="invoice_amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field
                                name="iva_amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field
                                name="retention_amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field name="state" />
                        </list>
                    </field>
                </page>
                <page
                    name="islr_retention"
                    string="ISLR Retentions"
                    invisible="not retention_islr_line_ids"
                >
                    <field
                        name="retention_islr_line_ids"
                        nolabel="1"
                        readonly="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"
                    >
                        <list editable='bottom'>
                            <!-- Invisible Fields -->
                            <field name="invoice_type" column_invisible="True" />
                            <field name="company_currency_id" column_invisible="True" />
                            <field name="name" />
                            <field name="payment_concept_id" />
                            <field
                                name="invoice_total"
                                readonly="1"
                                force_save="1"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field
                                name="invoice_amount"
                                force_save="1"
                                string="Invoice Amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field
                                name="related_pay_from"
                                force_save="1"
                                readonly="1"
                            />
                            <field
                                name="related_percentage_tax_base"
                                force_save="1"
                                readonly="1"
                            />
                            <field
                                name="related_percentage_fees"
                                force_save="1"
                                readonly="1"
                            />
                            <field
                                name="related_amount_subtract_fees"
                                force_save="1"
                                readonly="1"
                            />
                            <field
                                name="retention_amount"
                                readonly="1"
                                force_save="1"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field name="state" />
                        </list>
                    </field>
                </page>
                <page
                    name="municipal_retention"
                    string="Municipal Retentions"
                    invisible="1"
                >
                    <field
                        name="retention_municipal_line_ids"
                        nolabel="1"
                        readonly="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"
                    >
                        <list editable='bottom'>
                            <field name="name" force_save="1" readonly="1" />
                            <field name="economic_activity_id" force_save="1" />
                            <field name="aliquot" readonly="1" force_save="1" />
                            <field
                                name="invoice_amount"
                                force_save="1"
                                string="Invoice Amount"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field
                                name="invoice_total"
                                readonly="1"
                                force_save="1"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field
                                name="retention_amount"
                                readonly="1"
                                force_save="1"
                                widget="monetary"
                                options="{'currency_field': 'company_currency_id'}"
                            />
                            <field name="state" force_save="1" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
