<?xml version="1.0" encoding="utf-8" ?>
<odoo auto_sequence="1">
    <delete
        model="account.report.column"
        search="[('expression_label', '=', 'document'), ('report_id', '=', ref('l10n_ve_reports.daily_payments_report'))]"
    />

    <record id="daily_payments_report" model="account.report">
        <field name="name">🇻🇪 Pagos por día y diario</field>
        <field name="filter_journals" eval="True" />
        <field name="filter_show_draft" eval="False" />
        <field name="filter_unfold_all" eval="True" />
        <field name="filter_hierarchy">never</field>
        <field name="filter_period_comparison" eval="False" />
        <field name="filter_unreconciled" eval="False" />
        <field name="filter_hide_0_lines">never</field>
        <field name="filter_date_range" eval="True" />
        <field name="default_opening_date_filter">today</field>
        <field
            name="custom_handler_model_id"
            ref="model_account_daily_payments_report_handler_oca"
        />
        <field name="column_ids">
            <record id="daily_payments_report_date" model="account.report.column">
                <field name="name">Fecha</field>
                <field name="expression_label">line_date</field>
                <field name="figure_type">date</field>
            </record>
            <record
                id="daily_payments_report_invoice_documents"
                model="account.report.column"
            >
                <field name="name">Documentos</field>
                <field name="expression_label">invoice_documents</field>
                <field name="figure_type">string</field>
            </record>
            <record id="daily_payments_report_partner" model="account.report.column">
                <field name="name">Contacto</field>
                <field name="expression_label">partner</field>
                <field name="figure_type">string</field>
            </record>
            <record id="daily_payments_report_amount" model="account.report.column">
                <field name="name">Importe (moneda del informe)</field>
                <field name="expression_label">amount</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>
</odoo>
