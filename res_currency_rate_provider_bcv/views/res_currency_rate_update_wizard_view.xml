<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_currency_rate_update_wizard_form" model="ir.ui.view">
        <field name="name">res.currency.rate.update.wizard.form.inherit.bcv</field>
        <field name="model">res.currency.rate.update.wizard</field>
        <field
            name="inherit_id"
            ref="currency_rate_update.res_currency_rate_update_wizard_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <div
                    class="alert alert-info"
                    role="alert"
                    style="margin: 10px; border-left: 5px solid #004085;"
                >
                    <p style="margin-bottom: 0;">
                        <strong>BCV Notice:</strong>
                        This provider only supports the official rate for the current
                        day. If BCV is selected, any date range defined above will be
                        ignored for Venezuelan currencies.
                    </p>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
