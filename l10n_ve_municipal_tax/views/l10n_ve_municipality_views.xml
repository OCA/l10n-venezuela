<odoo>
    <record id="view_l10n_ve_municipality_list" model="ir.ui.view">
        <field name="name">l10n.ve.municipality.list</field>
        <field name="model">l10n.ve.municipality</field>
        <field name="arch" type="xml">
            <list string="Municipalities" editable="bottom">
                <field name="name" />
                <field name="state_id" options="{'no_create': True}" />
                <field name="code" optional="show" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="view_l10n_ve_municipality_search" model="ir.ui.view">
        <field name="name">l10n.ve.municipality.search</field>
        <field name="model">l10n.ve.municipality</field>
        <field name="arch" type="xml">
            <search string="Municipalities">
                <field name="name" />
                <field name="state_id" />
                <field name="code" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ve_municipality" model="ir.actions.act_window">
        <field name="name">Municipalities (VE)</field>
        <field name="res_model">l10n.ve.municipality</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add the municipalities where your companies pay municipal tax
            </p>
        </field>
    </record>

    <menuitem
        id="menu_l10n_ve_municipality"
        name="Municipalities (VE)"
        parent="account.menu_finance_configuration"
        action="action_l10n_ve_municipality"
        groups="account.group_account_manager"
        sequence="90"
    />
</odoo>
