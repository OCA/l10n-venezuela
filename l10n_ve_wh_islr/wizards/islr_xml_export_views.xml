<odoo>
    <record id="l10n_ve_islr_xml_export_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.islr.xml.export.view.form</field>
        <field name="model">l10n.ve.islr.xml.export</field>
        <field name="arch" type="xml">
            <form string="Exportar XML de Retenciones ISLR">
                <group>
                    <group>
                        <field
                            name="company_id"
                            groups="base.group_multi_company"
                            options="{'no_create': True}"
                        />
                        <field name="year" />
                        <field name="month" />
                    </group>
                    <group>
                        <field name="file_name" invisible="1" />
                        <field
                            name="file_data"
                            filename="file_name"
                            readonly="1"
                            invisible="not file_data"
                        />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generar XML"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cerrar"
                        special="cancel"
                        class="btn-secondary"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_l10n_ve_islr_xml_export" model="ir.actions.act_window">
        <field name="name">XML Retenciones ISLR (SENIAT)</field>
        <field name="res_model">l10n.ve.islr.xml.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_l10n_ve_islr_xml_export"
        name="XML Retenciones ISLR (SENIAT)"
        parent="account.menu_finance_payables"
        action="action_l10n_ve_islr_xml_export"
        sequence="81"
    />
</odoo>
