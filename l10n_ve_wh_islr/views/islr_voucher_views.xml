<odoo>
    <record id="l10n_ve_islr_voucher_view_list" model="ir.ui.view">
        <field name="name">l10n.ve.islr.voucher.view.list</field>
        <field name="model">l10n.ve.islr.voucher</field>
        <field name="arch" type="xml">
            <list>
                <field name="number" />
                <field name="date" />
                <field name="partner_id" />
                <field name="concept_id" />
                <field name="base" sum="Total Base" />
                <field name="amount" sum="Total Retenido" />
                <field name="currency_id" column_invisible="1" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'issued'"
                    decoration-danger="state == 'cancelled'"
                />
            </list>
        </field>
    </record>
    <record id="l10n_ve_islr_voucher_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.islr.voucher.view.form</field>
        <field name="model">l10n.ve.islr.voucher</field>
        <field name="arch" type="xml">
            <form string="Comprobante de Retención ISLR">
                <header>
                    <button
                        name="action_issue"
                        type="object"
                        string="Emitir"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Anular"
                        invisible="state == 'cancelled'"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Pasar a Borrador"
                        invisible="state != 'cancelled'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,issued"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="number" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Agente de Retención">
                            <field name="company_id" readonly="state != 'draft'" />
                            <field name="company_vat" />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="period" />
                        </group>
                        <group string="Sujeto Retenido">
                            <field name="partner_id" readonly="state != 'draft'" />
                            <field name="partner_vat" />
                            <field name="person_type" readonly="state != 'draft'" />
                            <field name="payment_id" readonly="1" />
                        </group>
                        <group string="Retención">
                            <field name="concept_id" readonly="state != 'draft'" />
                            <field name="rate" readonly="state != 'draft'" />
                            <field name="currency_id" invisible="1" />
                            <field name="base" readonly="state != 'draft'" />
                            <field name="subtrahend" readonly="state != 'draft'" />
                            <field name="amount" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Facturas Afectadas" name="moves">
                            <field name="move_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="name" />
                                    <field name="ref" />
                                    <field name="invoice_date" />
                                    <field name="amount_total" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_ve_islr_voucher_view_search" model="ir.ui.view">
        <field name="name">l10n.ve.islr.voucher.view.search</field>
        <field name="model">l10n.ve.islr.voucher</field>
        <field name="arch" type="xml">
            <search string="Comprobantes ISLR">
                <field name="number" />
                <field name="partner_id" />
                <field name="concept_id" />
                <field name="period" />
                <filter
                    name="filter_issued"
                    string="Emitidos"
                    domain="[('state', '=', 'issued')]"
                />
                <filter
                    name="filter_draft"
                    string="Borradores"
                    domain="[('state', '=', 'draft')]"
                />
                <separator />
                <filter
                    name="group_by_period"
                    string="Período"
                    context="{'group_by': 'period'}"
                />
                <filter
                    name="group_by_partner"
                    string="Sujeto Retenido"
                    context="{'group_by': 'partner_id'}"
                />
                <filter
                    name="group_by_concept"
                    string="Concepto"
                    context="{'group_by': 'concept_id'}"
                />
            </search>
        </field>
    </record>
    <record id="action_l10n_ve_islr_voucher" model="ir.actions.act_window">
        <field name="name">Comprobantes de Retención ISLR</field>
        <field name="res_model">l10n.ve.islr.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_ve_islr_voucher_view_search" />
    </record>
    <menuitem
        id="menu_l10n_ve_islr_voucher"
        name="Comprobantes ISLR"
        parent="account.menu_finance_payables"
        action="action_l10n_ve_islr_voucher"
        sequence="80"
    />
</odoo>
