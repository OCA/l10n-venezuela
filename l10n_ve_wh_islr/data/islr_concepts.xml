<odoo noupdate="1">
    <!-- Códigos oficiales del Anexo 6.1 del Manual Técnico XML del SENIAT
         (Decreto 1.808), columnas PN Residente / PJ Domiciliada.
         El código 000 (Declaración Sin Operaciones) NO se seedea como concepto:
         lo emite el wizard de export cuando el período no tiene comprobantes.
         Conceptos solo-PJ dejan el código PN en el default '000' (el export
         bloquea comprobantes con ese código). -->
    <record id="islr_concept_honorarios" model="l10n.ve.islr.concept">
        <field name="name">Honorarios Profesionales</field>
        <field name="seniat_code_pj">003</field>
        <field name="seniat_code_pn">002</field>
        <field name="rate_pj_dom">5.0</field>
        <field name="rate_pn_res">3.0</field>
        <field name="apply_subtrahend" eval="True" />
    </record>
    <record id="islr_concept_comisiones" model="l10n.ve.islr.concept">
