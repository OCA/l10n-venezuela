<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OpeningControlPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('opening-cash-section')]" position="replace">
            <div class="opening-cash-section mb-3" t-if="this.cashMethodCount">
                <t t-foreach="getCashPaymentMethods()" t-as="cashMethod" t-key="cashMethod.id">
                    <label class="form-label">
                        Opening cash — <t t-esc="formatOpeningCashLabel(cashMethod)"/>
                    </label>
                    <div t-att-class="{ 'w-50': !ui.isSmall }" class="cash-input-sub-section d-flex gap-1 mb-2">
                        <Input tModel="[state.openingCashByMethod, cashMethod.id]"
                            isValid.bind="env.utils.isValidFloat"
                            callback.bind="() => this.handleMethodInputChange(cashMethod)"
                            autofocus="cashMethod_index === 0"
                            icon="{type: 'string', value: getCurrencySymbol(cashMethod)}"
                            iconOnLeftSide="false"
                            class="'flex-grow-1'"
                            placeholder.translate="Opening Balance Eg: 123"/>
                        <div class="button icon btn btn-secondary btn-lg lh-lg"
                            t-on-click="() => this.openDetailsPopup(cashMethod)">
                            <i class="fa fa-money" role="img" title="Open the money details popup"/>
                        </div>
                    </div>
                </t>
            </div>
        </xpath>
        <xpath expr="//button[hasclass('btn-primary')]" position="attributes">
            <attribute name="t-att-disabled">!canConfirmOpening()</attribute>
        </xpath>
    </t>
</templates>
