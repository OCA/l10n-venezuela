<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="currency_pos.CurrencyRatesWidget">
        <t t-if="rates.length > 0">
            <div class="currency-rates-container px-3 py-2 border-bottom bg-white">
                <div class="d-flex flex-wrap gap-2">
                    <t t-foreach="rates" t-as="rateData" t-key="rateData.currency.id">
                        <div class="currency-rate-item d-flex align-items-center gap-1">
                            <span class="fw-semibold" t-esc="rateData.label"/>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </t>
</templates>
