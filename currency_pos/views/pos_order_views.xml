<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_currency_pos" model="ir.ui.view">
        <field name="name">pos.order.form.currency.pos</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ids']//field[@name='amount']" position="after">
                <field name="payment_currency_id" optional="show"/>
                <field name="payment_currency_amount" optional="show"/>
                <field name="payment_currency_rate" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
