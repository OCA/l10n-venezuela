<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_warehouse_inherit_l10n_ve_reports_stock" model="ir.ui.view">
        <field name="name">stock.warehouse.form.inherit.l10n.ve.reports.stock</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='warehouse_config']" position="inside">
                <group string="Libro de Inventario SENIAT">
                    <field name="l10n_ve_location_retiros_id" />
                    <field name="l10n_ve_location_autoconsumos_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
