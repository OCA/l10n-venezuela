<?xml version="1.0" encoding="utf-8" ?>
<odoo auto_sequence="1">
    <record id="inventory_book_report" model="account.report">
        <field name="name">Libro de Inventario</field>
        <field name="filter_journals" eval="False" />
        <field name="filter_show_draft" eval="False" />
        <field name="filter_hierarchy">never</field>
        <field name="filter_period_comparison" eval="False" />
        <field name="filter_hide_0_lines">never</field>
        <field name="default_opening_date_filter">this_month</field>
        <field
            name="custom_handler_model_id"
            ref="model_stock_inventory_book_report_handler_oca"
        />
        <field name="column_ids">
            <record id="inventory_book_report_code" model="account.report.column">
                <field name="name">Código</field>
                <field name="expression_label">code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="inventory_book_report_product" model="account.report.column">
                <field name="name">Producto</field>
                <field name="expression_label">product</field>
                <field name="figure_type">string</field>
            </record>
            <record id="inventory_book_report_cost" model="account.report.column">
                <field name="name">Costo Promedio</field>
                <field name="expression_label">cost</field>
                <field name="figure_type">monetary</field>
            </record>
            <record
                id="inventory_book_report_inv_initial_qty"
                model="account.report.column"
            >
                <field name="name">Inv. Inicial (Ud)</field>
                <field name="expression_label">inv_initial_qty</field>
                <field name="figure_type">float</field>
            </record>
            <record
                id="inventory_book_report_inv_initial_val"
                model="account.report.column"
            >
                <field name="name">Inv. Inicial (Valor)</field>
                <field name="expression_label">inv_initial_val</field>
                <field name="figure_type">monetary</field>
            </record>
            <record
                id="inventory_book_report_entradas_qty"
                model="account.report.column"
            >
                <field name="name">Entradas (Ud)</field>
                <field name="expression_label">entradas_qty</field>
                <field name="figure_type">float</field>
            </record>
            <record
                id="inventory_book_report_entradas_val"
                model="account.report.column"
            >
                <field name="name">Entradas (Valor)</field>
                <field name="expression_label">entradas_val</field>
                <field name="figure_type">monetary</field>
            </record>
            <record
                id="inventory_book_report_salidas_qty"
                model="account.report.column"
            >
                <field name="name">Salidas (Ud)</field>
                <field name="expression_label">salidas_qty</field>
                <field name="figure_type">float</field>
            </record>
            <record
                id="inventory_book_report_salidas_val"
                model="account.report.column"
            >
                <field name="name">Salidas (Valor)</field>
                <field name="expression_label">salidas_val</field>
                <field name="figure_type">monetary</field>
            </record>
            <record
                id="inventory_book_report_retiros_qty"
                model="account.report.column"
            >
                <field name="name">Retiros (Ud)</field>
                <field name="expression_label">retiros_qty</field>
                <field name="figure_type">float</field>
            </record>
            <record
                id="inventory_book_report_retiros_val"
                model="account.report.column"
            >
                <field name="name">Retiros (Valor)</field>
                <field name="expression_label">retiros_val</field>
                <field name="figure_type">monetary</field>
            </record>
            <record
                id="inventory_book_report_autoconsumos_qty"
                model="account.report.column"
            >
                <field name="name">Autoconsumos (Ud)</field>
                <field name="expression_label">autoconsumos_qty</field>
                <field name="figure_type">float</field>
            </record>
            <record
                id="inventory_book_report_autoconsumos_val"
                model="account.report.column"
            >
                <field name="name">Autoconsumos (Valor)</field>
                <field name="expression_label">autoconsumos_val</field>
                <field name="figure_type">monetary</field>
            </record>
            <record
                id="inventory_book_report_inv_final_qty"
                model="account.report.column"
            >
                <field name="name">Inv. Final (Ud)</field>
                <field name="expression_label">inv_final_qty</field>
                <field name="figure_type">float</field>
            </record>
            <record
                id="inventory_book_report_inv_final_val"
                model="account.report.column"
            >
                <field name="name">Inv. Final (Valor)</field>
                <field name="expression_label">inv_final_val</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>
</odoo>
