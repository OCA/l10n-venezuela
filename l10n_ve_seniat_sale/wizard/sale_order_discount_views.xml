<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_sale_order_discount_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.order.discount.form.ve</field>
        <field name="model">sale.order.discount</field>
        <field name="arch" type="xml">
            <form string="Descuento global">
                <group>
                    <field name="sale_order_id" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="currency_id" invisible="1" />
                    <field name="discount_type" invisible="1" />
                    <field name="tax_ids" invisible="1" />
                    <field
                        name="l10n_ve_discount_mode"
                        widget="radio"
                        options="{'horizontal': true}"
                    />
                    <field
                        name="l10n_ve_discount_reason_id"
                        options="{'no_create': True}"
                    />
                    <field
                        name="discount_percentage"
                        widget="percentage"
                        invisible="l10n_ve_discount_mode != 'percentage'"
                        required="l10n_ve_discount_mode == 'percentage'"
                    />
                    <field
                        name="l10n_ve_amount_base"
                        widget="radio"
                        options="{'horizontal': true}"
                        invisible="l10n_ve_discount_mode != 'amount'"
                        required="l10n_ve_discount_mode == 'amount'"
                    />
                    <field
                        name="discount_amount"
                        invisible="l10n_ve_discount_mode != 'amount'"
                        required="l10n_ve_discount_mode == 'amount'"
                    />
                </group>
                <footer>
                    <button
                        name="action_apply_discount"
                        type="object"
                        string="Aplicar"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancelar" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
