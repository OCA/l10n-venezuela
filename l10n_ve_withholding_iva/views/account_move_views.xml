<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.wh.iva</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button
                    name="action_l10n_ve_create_iva_wh"
                    string="Crear retención de IVA"
                    type="object"
                    groups="account.group_account_invoice"
                    invisible="state != 'posted' or country_code != 'VE' or move_type != 'in_invoice' or l10n_ve_iva_wh_voucher_id or l10n_ve_iva_wh_excluded"
                />
            </button>
            <group id="other_tab_group" position="inside">
                <group
                    string="Retención de IVA"
                    name="l10n_ve_withholding_iva"
                    invisible="country_code != 'VE' or move_type not in ('in_invoice', 'in_refund')"
                >
                    <field
                        name="l10n_ve_iva_wh_excluded"
                        readonly="state != 'draft'"
                        invisible="move_type != 'in_invoice'"
                    />
                    <field
                        name="l10n_ve_iva_wh_voucher_id"
                        invisible="not l10n_ve_iva_wh_voucher_id"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
