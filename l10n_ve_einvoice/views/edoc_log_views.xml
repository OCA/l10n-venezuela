<odoo>
    <record id="l10n_ve_edoc_log_view_list" model="ir.ui.view">
        <field name="name">l10n.ve.edoc.log.list</field>
        <field name="model">l10n.ve.edoc.log</field>
        <field name="arch" type="xml">
            <list string="Electronic Document Logs" create="false">
                <field name="create_date" string="Date and Time" />
                <field name="move_id" />
                <field name="endpoint" />
                <field name="ok" widget="boolean_toggle" readonly="1" />
                <field name="create_uid" string="User" />
            </list>
        </field>
    </record>

    <record id="l10n_ve_edoc_log_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.edoc.log.form</field>
        <field name="model">l10n.ve.edoc.log</field>
        <field name="arch" type="xml">
            <form string="Electronic Document Log" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="move_id" />
                        <field name="endpoint" />
                        <field name="ok" />
                        <field name="create_date" string="Date and Time" />
                        <field name="create_uid" string="User" />
                    </group>
                    <group string="Request">
                        <field name="request" nolabel="1" />
                    </group>
                    <group string="Response">
                        <field name="response" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ve_edoc_log_action" model="ir.actions.act_window">
        <field name="name">Electronic Document Logs</field>
        <field name="res_model">l10n.ve.edoc.log</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]" />
    </record>

    <menuitem
        id="l10n_ve_edoc_log_menu"
        name="Electronic Document Logs"
        parent="account.menu_finance_reports"
        action="l10n_ve_edoc_log_action"
        groups="account.group_account_invoice"
        sequence="90"
    />
</odoo>
