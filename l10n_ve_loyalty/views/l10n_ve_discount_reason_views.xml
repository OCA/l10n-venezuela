<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_discount_reason_view_list" model="ir.ui.view">
        <field name="name">l10n.ve.discount.reason.list</field>
        <field name="model">l10n.ve.discount.reason</field>
        <field name="arch" type="xml">
            <list string="Razones de descuento" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="l10n_ve_discount_reason_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.discount.reason.form</field>
        <field name="model">l10n.ve.discount.reason</field>
        <field name="arch" type="xml">
            <form string="Razón de descuento">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ve_discount_reason_action" model="ir.actions.act_window">
        <field name="name">Razones de descuento</field>
        <field name="res_model">l10n.ve.discount.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_l10n_ve_discount_reason"
        name="Razones de descuento"
        parent="account.menu_account_config"
        action="l10n_ve_discount_reason_action"
        sequence="45"
        groups="account.group_account_manager"
    />
</odoo>
