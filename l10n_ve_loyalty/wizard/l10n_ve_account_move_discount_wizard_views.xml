<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_account_move_discount_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.account.move.discount.wizard.form</field>
        <field name="model">l10n.ve.account.move.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="Descuento global">
                <group>
                    <field name="move_id" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="currency_id" invisible="1" />
                    <field name="discount_mode" widget="radio" options="{'horizontal': true}" />
                    <field name="reason_id" options="{'no_create': True}" />
                    <field
                        name="discount_percentage"
                        widget="percentage"
                        invisible="discount_mode != 'percentage'"
                        required="discount_mode == 'percentage'"
                    />
                    <field
                        name="amount_base"
                        widget="radio"
                        options="{'horizontal': true}"
                        invisible="discount_mode != 'amount'"
                        required="discount_mode == 'amount'"
                    />
                    <field
                        name="amount"
                        invisible="discount_mode != 'amount'"
                        required="discount_mode == 'amount'"
                    />
                </group>
                <footer>
                    <button
                        name="action_apply_discount"
                        type="object"
                        string="Aplicar"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancelar" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
