<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="l10n_ve_edi.EdiUnsentDashboard">
        <div
            t-if="state.visible"
            class="o_l10n_ve_invoice_dashboard_card o_l10n_ve_edi_unsent_dashboard flex-grow-1 d-flex flex-column border-0 rounded-0"
        >
            <div class="p-3 text-center">
                <span
                    class="o_l10n_ve_edi_unsent_dashboard_title fw-semibold"
                    t-out="state.title"
                />
                <div class="d-flex justify-content-around align-items-start mt-2 gap-2">
                    <t t-foreach="state.items" t-as="item" t-key="item.key">
                        <button
                            type="button"
                            class="btn flex-grow-1 d-flex flex-column p-2 border-0 rounded-0 bg-transparent"
                            t-att-data-key="item.key"
                            t-on-click="() => this.openItem(item.key)"
                        >
                            <span
                                class="o_l10n_ve_invoice_dashboard_count h3 m-0 mb-1"
                                t-out="item.count"
                            />
                            <span
                                class="o_l10n_ve_invoice_dashboard_label small"
                                t-out="item.label"
                            />
                        </button>
                    </t>
                </div>
            </div>
        </div>
    </t>

    <t
        t-name="l10n_ve_edi.SeniatInvoiceDashboard"
        t-inherit="l10n_ve_seniat.SeniatInvoiceDashboard"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_l10n_ve_invoice_dashboard')]" position="inside">
            <EdiUnsentDashboard />
        </xpath>
    </t>
</templates>
