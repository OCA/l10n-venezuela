<odoo>
    <record id="view_move_form_l10n_ve_edi" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header//field[@name='state'][1]" position="before">
                <button
                    name="action_l10n_ve_edi_send"
                    type="object"
                    string="Enviar facturacion digital"
                    icon="fa-upload"
                    class="oe_highlight"
                    groups="account.group_account_invoice"
                    invisible="state != 'posted' or not l10n_ve_edi_show_tab or l10n_ve_edi_send_state != 'not_sent'"
                />
            </xpath>
            <xpath expr="//form/sheet" position="before">
                <field name="l10n_ve_edi_show_tab" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or not l10n_ve_edi_show_tab or l10n_ve_edi_send_state != 'not_sent'"
                >
                    <span
                    >Esta factura aun no se ha enviado a facturacion digital. Pulse </span>
                    <button
                        name="action_l10n_ve_edi_send"
                        type="object"
                        string="Enviar facturacion digital"
                        icon="fa-upload"
                        class="oe_link p-0 align-baseline"
                    />
                    <span> cuando corresponda.</span>
                </div>
                <div
                    class="alert alert-info"
                    role="alert"
                    invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or not l10n_ve_edi_show_tab or l10n_ve_edi_send_state != 'queued'"
                >
                    <span
                    >El envio a facturacion digital esta en cola; espere a que finalice el trabajo.</span>
                </div>
                <div
                    class="alert alert-danger"
                    role="alert"
                    invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or not l10n_ve_edi_show_tab or l10n_ve_edi_send_state != 'failed'"
                >
                    <span>Fallo el envio a facturacion digital: </span>
                    <field
                        name="l10n_ve_edi_last_error"
                        readonly="1"
                        nolabel="1"
                        class="oe_inline"
                    />
                    <span> - </span>
                    <button
                        name="action_l10n_ve_edi_retry_send"
                        type="object"
                        string="Reintentar envio"
                        class="oe_link"
                    />
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    string="Facturacion digital (EDI)"
                    name="l10n_ve_edi_tab"
                    invisible="move_type not in ('out_invoice', 'out_refund') or not l10n_ve_edi_show_tab"
                >
                    <group>
                        <group>
                            <field name="l10n_ve_edi_send_state" readonly="1" />
                            <field name="l10n_ve_edi_sent_at" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="l10n_ve_edi_payload_attachment_id"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="l10n_ve_edi_last_error" readonly="1" />
                        <field
                            name="l10n_ve_edi_response_json"
                            readonly="1"
                            widget="text"
                        />
                    </group>
                    <group groups="base.group_no_one">
                        <field
                            name="l10n_ve_edi_payload_debug_json"
                            readonly="1"
                            widget="text"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_l10n_ve_edi_vendor_fiscal" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.edi.vendor.fiscal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_ve_seniat.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_ve_control_number'][1]" position="after">
                <label
                    for="l10n_ve_invoice_number"
                    string="N° Factura proveedor"
                    invisible="move_type not in ('in_invoice', 'in_refund') or country_code != 'VE'"
                />
                <field
                    name="l10n_ve_invoice_number"
                    nolabel="1"
                    placeholder="Numero impreso en la factura del proveedor"
                    invisible="move_type not in ('in_invoice', 'in_refund') or country_code != 'VE'"
                    readonly="state == 'cancel'"
                />
            </xpath>
        </field>
    </record>
</odoo>
