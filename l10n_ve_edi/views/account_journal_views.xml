<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_l10n_ve_edi" model="ir.ui.view">
        <field name="name">account.journal.form.l10n.ve.edi</field>
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="l10n_ve_seniat.view_account_journal_form_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='l10n_ve_seniat_page']" position="inside">
                <group
                    name="l10n_ve_edi_digital_group"
                    string="Facturacion digital (EDI)"
                    invisible="l10n_ve_emission_medium != 'digital'"
                >
                    <field name="l10n_ve_edi_provider" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
