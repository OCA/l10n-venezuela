<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_ve_fiscal_serial_pos.ReceiptScreen"
        t-inherit="l10n_ve_pos.ReceiptScreen"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_payment_successful')]/hr" position="after">
            <button
                t-if="l10nVeShowFiscalReprint"
                type="button"
                class="btn btn-primary w-100 mt-2 py-2"
                t-att-disabled="l10nVeFiscalReprint.status === 'loading'"
                t-on-click="() => this.l10nVeFiscalReprint.call()"
            >
                <i
                    t-attf-class="fa {{l10nVeFiscalReprint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1"
                />
                <t t-esc="l10nVeFiscalReprintLabel" />
            </button>
        </xpath>
    </t>
</templates>
