<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_ve_stock_picking_validate_confirmation" model="ir.ui.view">
        <field name="name">l10n_ve.stock.picking.validate.confirmation.form</field>
        <field name="model">l10n_ve.stock.picking.validate.confirmation</field>
        <field name="arch" type="xml">
            <form string="Confirmar guía de despacho">
                <field name="picking_ids" invisible="1" />
                <field name="l10n_ve_next_control_number" invisible="1" />
                <div class="alert alert-warning mb-0" role="alert">
                    <field name="l10n_ve_confirmation_message" nolabel="1" />
                </div>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirmar entrega"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
