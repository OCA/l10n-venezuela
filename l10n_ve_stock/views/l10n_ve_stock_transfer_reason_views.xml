<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_ve_stock_transfer_reason_tree" model="ir.ui.view">
        <field name="name">l10n_ve.stock.transfer.reason.list</field>
        <field name="model">l10n_ve.stock.transfer.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="action_l10n_ve_stock_transfer_reason" model="ir.actions.act_window">
        <field name="name">Motivos de traslado (VE)</field>
        <field name="res_model">l10n_ve.stock.transfer.reason</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
        id="menu_l10n_ve_stock_transfer_reason"
        name="Motivos traslado VE"
        parent="stock.menu_stock_config_settings"
        action="action_l10n_ve_stock_transfer_reason"
        sequence="95"
    />
</odoo>
