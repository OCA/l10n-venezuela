<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_unfactured_dispatch_guide_tree" model="ir.ui.view">
        <field name="name">stock.picking.unfactured.dispatch.guide.list</field>
        <field name="model">stock.picking</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="date_done desc">
                <field name="company_id" column_invisible="True" />
                <field name="picking_type_code" column_invisible="True" />
                <field name="l10n_ve_is_ve_country" column_invisible="True" />
                <field name="l10n_ve_dispatch_guide_date" string="Fecha" />
                <field name="l10n_ve_dispatch_guide_time" string="Hora" />
                <field name="partner_id" string="Cliente" readonly="1" />
                <field name="name" string="N° de guía" decoration-bf="1" />
                <field name="l10n_ve_control_number" string="N° de control" />
                <field name="l10n_ve_dispatch_guide_user_id" string="Usuario" />
                <field name="origin" optional="hide" readonly="1" />
                <field name="date_done" optional="hide" readonly="1" />
                <field name="scheduled_date" optional="hide" readonly="1" />
                <field name="l10n_ve_sales_user_id" optional="hide" readonly="1" />
                <field name="user_id" optional="hide" readonly="1" />
                <field
                    name="location_id"
                    optional="hide"
                    readonly="1"
                    groups="stock.group_stock_multi_locations"
                />
                <field
                    name="location_dest_id"
                    optional="hide"
                    readonly="1"
                    groups="stock.group_stock_multi_locations"
                />
                <field name="picking_type_id" optional="hide" readonly="1" />
                <field name="state" optional="hide" readonly="1" widget="badge" />
                <field name="backorder_id" optional="hide" readonly="1" />
                <field name="priority" optional="hide" readonly="1" widget="priority" />
                <field
                    name="company_id"
                    optional="hide"
                    readonly="1"
                    groups="base.group_multi_company"
                />
                <field name="sale_id" optional="hide" readonly="1" />
            </list>
        </field>
    </record>

    <record id="stock_picking_unfactured_dispatch_guide_search" model="ir.ui.view">
        <field name="name">stock.picking.unfactured.dispatch.guide.search</field>
        <field name="model">stock.picking</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <search string="Guías de despacho no facturadas">
                <field
                    name="name"
                    string="N° de guía"
                    filter_domain="['|', ('name', 'ilike', self), ('origin', 'ilike', self)]"
                />
                <field name="l10n_ve_control_number" string="N° de control" />
                <field name="l10n_ve_dispatch_guide_user_id" string="Usuario" />
                <field
                    name="partner_id"
                    filter_domain="[('partner_id', 'child_of', self)]"
                />
                <field name="origin" string="Documento origen" />
                <field name="product_id" />
                <field name="sale_id" />
                <field name="picking_type_id" />
                <separator />
                <filter
                    name="l10n_ve_with_control_number"
                    string="Con N° de control"
                    domain="['&amp;', ('l10n_ve_control_number', '!=', False), ('l10n_ve_control_number', '!=', '')]"
                />
                <filter
                    name="l10n_ve_without_control_number"
                    string="Sin N° de control"
                    domain="['|', ('l10n_ve_control_number', '=', False), ('l10n_ve_control_number', '=', '')]"
                />
                <separator />
                <filter
                    name="l10n_ve_dispatch_guide_date"
                    string="Fecha guía"
                    date="l10n_ve_dispatch_guide_date"
                />
                <filter name="date_done" string="Fecha de entrega" date="date_done" />
                <separator />
                <group expand="0" string="Agrupar por">
                    <filter
                        string="Usuario"
                        name="groupby_user"
                        context="{'group_by': 'l10n_ve_dispatch_guide_user_id'}"
                    />
                    <filter
                        string="Fecha guía"
                        name="groupby_date"
                        context="{'group_by': 'l10n_ve_dispatch_guide_date'}"
                    />
                    <filter
                        string="Cliente"
                        name="groupby_partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        string="Documento origen"
                        name="groupby_origin"
                        context="{'group_by': 'origin'}"
                    />
                    <filter
                        string="Tipo de operación"
                        name="groupby_picking_type"
                        context="{'group_by': 'picking_type_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record
        id="action_l10n_ve_unfactured_dispatch_guides"
        model="ir.actions.act_window"
    >
        <field name="name">Guías de despacho no facturadas</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="stock_picking_unfactured_dispatch_guide_tree" />
        <field
            name="search_view_id"
            ref="stock_picking_unfactured_dispatch_guide_search"
        />
        <field name="context">{'create': False}</field>
    </record>
</odoo>
