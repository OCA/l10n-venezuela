<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_inherit_l10n_ve_stock_dispatch" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n.ve.stock.dispatch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_date']" position="after">
                <field
                    name="l10n_ve_invoice_dispatch_guides"
                    colspan="2"
                    readonly="1"
                    invisible="move_type not in ('out_invoice', 'out_refund') or not l10n_ve_invoice_dispatch_guides"
                />
            </xpath>
        </field>
    </record>
</odoo>
