<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.taxpayer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Art. 13 num. 5-7 PA SNAT/2011/0071: RIF del adquiriente. -->
            <xpath expr="//field[@name='vat']" position="after">
                <field
                    name="taxpayer_type"
                    invisible="country_code != 'VE'"
                />
            </xpath>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">country_code == 'VE'</attribute>
            </xpath>
            <xpath
                expr="//sheet/group/group/div[hasclass('o_address_format')]/field[@name='state_id']"
                position="after"
            >
                <!-- Art. 13 num. 5 PA SNAT/2011/0071: domicilio fiscal (municipio/parroquia). -->
                <field
                    name="municipality_id"
                    class="o_address_state"
                    placeholder="Municipality"
                    domain="[('state_id', '=', state_id)]"
                    invisible="country_code != 'VE'"
                    readonly="type == 'contact' and parent_id"
                />
                <field
                    name="parish_id"
                    class="o_address_state"
                    placeholder="Parish"
                    domain="[('municipality_id', '=', municipality_id)]"
                    invisible="country_code != 'VE'"
                    readonly="type == 'contact' and parent_id"
                />
            </xpath>
            <xpath expr="//field[@name='company_type']" position="after">
                <h1 invisible="country_code != 'VE'">
                    <field name="vat" placeholder="VAT" />
                </h1>
            </xpath>
            <xpath
                expr="//page[@name='sales_purchases']//group[@name='sale']"
                position="inside"
            >
                <field name="customer_rank" string="Rango de cliente" />
            </xpath>
            <xpath
                expr="//page[@name='sales_purchases']//group[@name='purchase']"
                position="inside"
            >
                <field name="supplier_rank" string="Rango de proveedor" />
            </xpath>
        </field>
    </record>
</odoo>
