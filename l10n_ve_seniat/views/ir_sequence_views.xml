<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Acción para abrir la secuencia del número de control -->
    <record id="action_l10n_ve_control_number_sequence" model="ir.actions.act_window">
        <field name="name">N° de Control (Venezuela)</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">form</field>
        <field name="domain">[('code', '=', 'l10n_ve_control_number')]</field>
        <field
            name="context"
        >{'default_code': 'l10n_ve_control_number', 'search_default_code': 'l10n_ve_control_number'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure la secuencia para el N° de Control
            </p>
            <p>
                Esta secuencia generará automáticamente los números de control para las facturas venezolanas.
                El formato es un correlativo de 8 dígitos (00000001, 00000002, etc.).
                Cada compañía puede tener su propia secuencia independiente.
            </p>
        </field>
    </record>
</odoo>
