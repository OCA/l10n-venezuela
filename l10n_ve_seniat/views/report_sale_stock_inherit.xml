<odoo>
    <!-- Template para Presupuestos (Sale Orders) -->
    <template
        id="report_saleorder_document_inherit_l10n_ve_seniat"
        inherit_id="sale.report_saleorder_document"
    >
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" t-if="o.company_id.account_fiscal_country_id.code == 'VE'">
                <strong>Sin derecho a crédito fiscal.</strong>
            </div>
        </xpath>
    </template>
</odoo>
