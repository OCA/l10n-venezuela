<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_debit_note_form_l10n_ve" model="ir.ui.view">
        <field name="name">account.debit.note.form.l10n.ve</field>
        <field name="model">account.debit.note</field>
        <field name="inherit_id" ref="account_debit_note.view_account_debit_note" />
        <field name="arch" type="xml">
            <!-- Art. 22-24 PA SNAT/2011/0071: diario y fecha alineados con factura origen. -->
            <xpath expr="//field[@name='journal_id']" position="before">
                <field name="l10n_ve_fiscal_country_code" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute
                    name="readonly"
                >l10n_ve_fiscal_country_code == 'VE'</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute
                    name="readonly"
                >l10n_ve_fiscal_country_code == 'VE'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
