<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_emission_medium_view_list" model="ir.ui.view">
        <field name="name">l10n.ve.emission.medium.list</field>
        <field name="model">l10n.ve.emission.medium</field>
        <field name="arch" type="xml">
            <list string="Medios de emisión" create="false" edit="false" delete="false">
                <field name="sequence" readonly="1" />
                <field name="name" readonly="1" />
                <field name="code" readonly="1" />
                <field name="active" readonly="1" />
                <field name="description" readonly="1" optional="hide" />
            </list>
        </field>
    </record>

    <record id="l10n_ve_emission_medium_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.emission.medium.form</field>
        <field name="model">l10n.ve.emission.medium</field>
        <field name="arch" type="xml">
            <form string="Medio de emisión" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="name" readonly="1" />
                        <field name="code" readonly="1" />
                        <field name="sequence" readonly="1" />
                        <field name="active" readonly="1" />
                        <field name="description" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ve_emission_medium_action" model="ir.actions.act_window">
        <field name="name">Medios de emisión</field>
        <field name="res_model">l10n.ve.emission.medium</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
