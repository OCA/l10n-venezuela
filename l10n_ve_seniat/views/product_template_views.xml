<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_tree_l10n_ve_sale_tax" model="ir.ui.view">
        <!-- Art. 13 num. 9-11 PA SNAT/2011/0071: alícuota de venta por producto. -->
        <field name="name">product.template.list.l10n.ve.sale.tax</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_view_tree" />
        <field name="arch" type="xml">
            <field name="taxes_id" position="before">
                <field name="l10n_ve_sale_tax_id" optional="show" />
            </field>
            <field name="taxes_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="supplier_taxes_id" position="before">
                <field name="l10n_ve_purchase_tax_id" optional="show" />
            </field>
            <field name="supplier_taxes_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>
    <record id="product_template_form_l10n_ve_sale_tax" model="ir.ui.view">
        <field name="name">product.template.form.l10n.ve.sale.tax</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@name='taxes_div']//field[@name='taxes_id']"
                position="before"
            >
                <field
                    name="l10n_ve_sale_tax_id"
                    class="oe_inline"
                    context="{
                        'default_type_tax_use': 'sale',
                        'search_default_sale': 1,
                        'search_default_service': type == 'service',
                        'search_default_goods': type == 'consu',
                        'append_fields': ['company_id'],
                    }"
                    options="{'no_create': True}"
                />
            </xpath>
            <xpath expr="//label[@for='taxes_id']" position="attributes">
                <attribute name="for">l10n_ve_sale_tax_id</attribute>
            </xpath>
            <xpath
                expr="//div[@name='taxes_div']//field[@name='taxes_id']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="supplier_taxes_id" position="before">
                <field
                    name="l10n_ve_purchase_tax_id"
                    invisible="not purchase_ok or type == 'combo'"
                    context="{
                        'default_type_tax_use': 'purchase',
                        'search_default_purchase': 1,
                        'search_default_service': type == 'service',
                        'search_default_goods': type == 'consu',
                        'append_fields': ['company_id'],
                    }"
                    options="{'no_create': True}"
                />
            </field>
            <field name="supplier_taxes_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
    <record id="product_product_form_l10n_ve_sale_tax" model="ir.ui.view">
        <field name="name">product.product.form.normalized.l10n.ve.sale.tax</field>
        <field name="model">product.product</field>
        <field
            name="inherit_id"
            ref="account.product_product_view_form_normalized_account"
        />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='taxes_id']" position="attributes">
                <attribute name="for">l10n_ve_sale_tax_id</attribute>
            </xpath>
            <field name="taxes_id" position="before">
                <field
                    name="l10n_ve_sale_tax_id"
                    context="{
                        'default_type_tax_use': 'sale',
                        'search_default_sale': 1,
                    }"
                    options="{'no_create': True}"
                />
            </field>
            <field name="taxes_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
