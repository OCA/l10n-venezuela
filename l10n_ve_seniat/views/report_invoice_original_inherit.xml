<odoo>
    <template
        id="report_invoice_document_inherit_l10n_ve_seniat"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" t-if="o.company_id.account_fiscal_country_id.code == 'VE'">
                <strong>Sin derecho a crédito fiscal.</strong>
            </div>
        </xpath>

        <xpath
            expr="//div[@name='invoice_date']//div[@t-field='o.invoice_date']"
            position="replace"
        >
            <div
                t-if="o.l10n_ve_invoice_date and o.country_code == 'VE'"
                t-field="o.l10n_ve_invoice_date"
            >2023-09-12 10:30:00</div>
            <div t-else="" t-field="o.invoice_date">2023-09-12</div>
        </xpath>

        <xpath expr="//div[@id='right-elements']" position="attributes">
            <attribute name="t-attf-class">
                #{'col-7 mt-5' if (report_type == 'pdf' and o.tax_totals and o.tax_totals.get('display_in_company_currency') and o.company_currency_id != o.currency_id) else ('col-5 mt-5' if report_type == 'pdf' else 'col-12 col-md-5')} ms-5 d-inline-block float-end
            </attribute>
        </xpath>

        <xpath
            expr="//t[@t-call='account.document_tax_totals_company_currency_template']"
            position="replace"
        />

        <xpath
            expr="//div[@id='total']//t[@t-call='account.document_tax_totals']"
            position="replace"
        >
            <t
                t-if="o.tax_totals and o.tax_totals.get('display_in_company_currency') and o.company_currency_id != o.currency_id"
            >
                <table class="l10n_ve_totals_grid o_ignore_layout_styling">
                    <tr>
                        <td>
                            <table
                                class="o_total_table table-borderless avoid-page-break-inside l10n_ve_totals_table o_ignore_layout_styling"
                            >
                                <t t-set="tax_totals" t-value="o.tax_totals" />
                                <t t-set="currency" t-value="o.company_currency_id" />
                                <t
                                    t-set="same_tax_base"
                                    t-value="tax_totals['same_tax_base']"
                                />
                                <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                                    <tr class="o_subtotal">
                                        <td>
                                            <span
                                                t-out="subtotal['name']"
                                            >Untaxed Amount</span>
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-out="subtotal['base_amount']"
                                                t-options='{"widget": "monetary", "display_currency": currency}'
                                            >0.00</span>
                                        </td>
                                    </tr>
                                    <t
                                        t-foreach="subtotal['tax_groups']"
                                        t-as="tax_group"
                                    >
                                        <tr class="o_taxes">
                                            <t
                                                t-if="same_tax_base or tax_group['display_base_amount'] is None"
                                            >
                                                <td style="max-width: 200px;">
                                                    <span
                                                        t-out="tax_group['group_name']"
                                                    >Tax</span>
                                                </td>
                                                <td class="text-end o_price_total">
                                                    <span
                                                        class="text-nowrap"
                                                        t-out="tax_group['tax_amount']"
                                                        t-options='{"widget": "monetary", "display_currency": currency}'
                                                    >0.00</span>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td>
                                                    <span
                                                        t-out="tax_group['group_name']"
                                                    >Tax</span>
                                                    <span> on </span>
                                                    <span
                                                        class="text-nowrap"
                                                        t-out="tax_group['display_base_amount']"
                                                        t-options='{"widget": "monetary", "display_currency": currency}'
                                                    >0.00</span>
                                                </td>
                                                <td class="text-end o_price_total">
                                                    <span
                                                        class="text-nowrap"
                                                        t-out="tax_group['tax_amount']"
                                                        t-options='{"widget": "monetary", "display_currency": currency}'
                                                    >0.00</span>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </t>
                                <tr t-if="'cash_rounding_base_amount' in tax_totals">
                                    <td>Rounding</td>
                                    <td class="text-end">
                                        <span
                                            t-out="tax_totals['cash_rounding_base_amount']"
                                            t-options='{"widget": "monetary", "display_currency": currency}'
                                        >0</span>
                                    </td>
                                </tr>
                                <tr class="o_total">
                                    <td>
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            t-out="tax_totals['total_amount']"
                                            t-options='{"widget": "monetary", "display_currency": currency}'
                                        >0.00</strong>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td>
                            <table
                                class="o_total_table table-borderless avoid-page-break-inside l10n_ve_totals_table o_ignore_layout_styling"
                            >
                                <t t-call="account.document_tax_totals">
                                    <t t-set="tax_totals" t-value="o.tax_totals" />
                                    <t t-set="currency" t-value="o.currency_id" />
                                </t>
                            </table>
                        </td>
                    </tr>
                </table>
            </t>
            <t t-else="" t-call="account.document_tax_totals">
                <t t-set="tax_totals" t-value="o.tax_totals" />
                <t t-set="currency" t-value="o.currency_id" />
            </t>
        </xpath>
    </template>
</odoo>
