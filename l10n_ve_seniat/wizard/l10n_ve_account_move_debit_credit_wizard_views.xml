<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_account_move_debit_credit_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_ve.account.move.debit.credit.wizard.form</field>
        <field name="model">l10n_ve.account.move.debit.credit.wizard</field>
        <field name="arch" type="xml">
            <form string="Nota de crédito por nota de débito">
                <!-- Art. 22-24 PA SNAT/2011/0071: NC referenciada a ND adicional. -->
                <group>
                    <field name="move_id" invisible="1" />
                    <field name="debit_note_ids" readonly="1" widget="many2many_tags" />
                    <field
                        name="reason"
                        placeholder="Indique el motivo de la reversión..."
                    />
                </group>
                <footer>
                    <button
                        name="action_create_credit_note"
                        string="Crear nota de crédito"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="Cerrar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
