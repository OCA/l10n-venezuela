<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_ve_book_folio_void_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ve.book.folio.void.wizard.form</field>
        <field name="model">l10n_ve.book.folio.void.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular folio">
                <!-- Art. 27-28 PA SNAT/2011/0071: consumo de correlativo sin documento. -->
                <group>
                    <field name="book_id" readonly="1" />
                    <field name="section_id" options="{'no_create': True}" />
                    <field
                        name="reason"
                        placeholder="Indique el motivo por el que consume un correlativo sin factura u otro documento."
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirmar"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
