<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_l10n_ve_seniat_access" model="ir.module.category">
        <field name="name">Venezuela (SENIAT)</field>
        <field
            name="description"
        >Permisos de fiscalización y documentos venezolanos, independientes del apartado de contabilidad.</field>
        <field name="sequence">16</field>
    </record>

    <!-- <record id="create_out_refund" model="res.groups"> -->
    <!--     <field name="name">Create Out Refund Moves</field> -->
    <!--     <field name="category_id" ref="base.module_category_hidden" /> -->
    <!-- </record> -->

    <record id="group_fiscal_config_user" model="res.groups">
        <field name="name">Configuraciones fiscales usuario</field>
        <field name="category_id" ref="base.module_category_accounting_accounting" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')),(4,ref('base.user_admin'))]"
        />
    </record>
    <record id="group_fiscal_config_support" model="res.groups">
        <field name="name">Configuraciones fiscales soporte</field>
        <field name="category_id" ref="base.module_category_accounting_accounting" />
        <field name="implied_ids" eval="[(4, ref('group_fiscal_config_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')),(4,ref('base.user_admin'))]"
        />
    </record>
    <record id="group_support_user" model="res.groups">
        <field name="name">Support User (Journals)</field>
    </record>

    <record id="group_seniat_readonly" model="res.groups">
        <field name="name">SENIAT - Lectura contable</field>
        <field name="category_id" ref="base.module_category_accounting_accounting" />
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]" />
    </record>

    <record id="group_seniat" model="res.groups">
        <field name="name">SENIAT</field>
        <field name="category_id" ref="base.module_category_accounting_accounting" />
        <field name="comment">Acceso al menú principal SENIAT</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <record id="group_l10n_ve_override_locked_master_data" model="res.groups">
        <field name="name">SENIAT: omitir bloqueo de datos maestros sensibles</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <record id="group_l10n_ve_invoice_void" model="res.groups">
        <field name="name">Anular Facturas</field>
        <field
            name="category_id"
            ref="l10n_ve_seniat.module_category_l10n_ve_seniat_access"
        />
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('l10n_ve_seniat.group_l10n_ve_invoice_void'))]"
        />
    </record>

    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('l10n_ve_seniat.group_l10n_ve_override_locked_master_data'))]"
        />
    </record>
</odoo>
