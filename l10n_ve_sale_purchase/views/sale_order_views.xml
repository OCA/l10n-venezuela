<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_islr" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.islr</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/tree//field[@name='tax_id']"
                position="after"
            >
                <field name="islr_concept_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
